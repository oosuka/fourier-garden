{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "vitest",
    "jsx-a11y",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.2.7"
    },
    "vitest": {
      "typecheck": false
    }
  },
  "rules": {
    "eqeqeq": "error",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": [
        "src/main.tsx",
        "src/patterns/spectral-cathedral/definition.tsx",
        "src/patterns/mobius-choir/definition.tsx",
        "src/patterns/spectral-cathedral/qa/SpectralCathedralQa.tsx",
        "src/patterns/mobius-choir/qa/MobiusChoirQa.tsx"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["src/audio/AudioEngine.ts"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["public/audio/**/*.js"],
      "env": {
        "browser": false,
        "audioworklet": true
      },
      "rules": {
        "unicorn/prefer-add-event-listener": "off",
        "unicorn/require-post-message-target-origin": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "env": {
        "vitest": true
      }
    },
    {
      "files": ["src/audio/workletContract.test.ts", "src/audio/workletRuntime.test.ts"],
      "rules": {
        "import/default": "off"
      }
    },
    {
      "files": ["vite.config.ts"],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**"]
}
